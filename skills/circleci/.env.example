# Optional local settings for scripts/circleci.sh.
#
# Copy this file to the profile directory the helper resolves for the repository
# you are working in: `<repository-root>/.agents/skills/circleci/.env` (or the
# `.claude/skills/` equivalent) when that repository carries one, otherwise
# `.env` beside this file. `circleci.sh help` prints the resolved order.
#
# Prefer the per-repository location: this skill installs at user scope and is
# shared by every project, so a token left beside it becomes every project's
# default. A repository that carries a profile directory owns its settings
# outright — the skill's own .env is not used as a fallback there.
#
# Fill it locally and never commit .env.

# Personal CircleCI API token. Leave blank in this example.
CIRCLECI_TOKEN=

# Optional overrides. Normally inferred from the current repository and branch.
# Examples are placeholders, not live project values.
# CIRCLECI_PROJECT_SLUG=gh/owner/repository
# CI_REMOTE=upstream
# CI_BRANCH=feature/name

# Needed only when `job` cannot derive CircleCI's legacy v1 project path.
# CIRCLECI_PROJECT_V1=github/owner/repository
