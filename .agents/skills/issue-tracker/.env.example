# Copy to .env beside this file. .env is gitignored; never commit credentials.

# Required for create/comment unless --sign is passed. Use the actual agent or
# person posting; never impersonate someone else.
ISSUE_TRACKER_SIGNATURE=""

# Area labels are `area:<name>` by default. Repositories with an existing label
# scheme may change the prefix and color. To manage bare labels, set the prefix
# to an empty string and list every managed bare label in
# ISSUE_TRACKER_AREA_LABELS; this lets
# `area --set` distinguish area labels from unrelated labels safely.
ISSUE_TRACKER_AREA_PREFIX="area:"
ISSUE_TRACKER_AREA_COLOR="bfdadc"
ISSUE_TRACKER_AREA_LABELS=""

# Optional fallback for image uploads only. gh-image normally reads a logged-in
# browser session. If that cannot work (for example, an isolated Linux/WSL
# environment), copy the github.com `user_session` cookie value here.
#
# Chrome/Edge: DevTools -> Application -> Cookies -> https://github.com
# Firefox:     DevTools -> Storage -> Cookies -> https://github.com
#
# Use `user_session`, not `_gh_sess` or `dotcom_user`. It grants account access,
# expires/rotates, and must never appear in CLI arguments, issue text, or git.
GH_SESSION_TOKEN=""
