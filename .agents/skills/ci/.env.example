# CI operator credentials for the OctoStaff umbrella's CircleCI integration
# pipeline. Used by the `ci` skill's circleci.sh (and the `release` skill, which
# delegates its integration-CI trigger to circleci.sh). The skill is self-contained:
# circleci.sh loads THIS file's sibling `.env`, so keep both in this directory.
#
#   cp .agents/skills/ci/.env.example .agents/skills/ci/.env
#   # fill in the token below, then:
#   .agents/skills/ci/scripts/circleci.sh tests --all --dry-run
#
# circleci.sh reads .agents/skills/ci/.env on its own — you do not need to
# `source` it. Not needed for normal development — only for ops tasks (triggering the
# integration pipeline, watching runs, or deleting leftover multi-config
# definitions). (checks / unit / npm-publish run on GitHub Actions — no token
# needed here.)

# Personal API token from https://app.circleci.com/settings/user/tokens.
CIRCLECI_TOKEN=
